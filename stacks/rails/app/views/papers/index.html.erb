<% content_for :title, "書類" %>
<div data-testid="screen-papers">
  <h1>書類</h1>
  <p><%= @patient.name_kanji %>（<%= @patient.karte_no %>）</p>

  <% if @success %>
    <p data-testid="success-banner">保存しました。</p>
  <% end %>
  <% if @error %>
    <p data-testid="error-banner"><%= @error_message %></p>
  <% end %>

  <%# 「取り込んでいない」と「元から無い」は画面上どちらも空に見えるため、区別できる
      印を出す（spec/screens.md #13「できること」、2026-09-06 指揮役の指摘）。 %>
  <% if @patient.no_paper? %>
    <p data-testid="no-paper-flag">この子の紙カルテは元から無い、という印が付いています。</p>
  <% elsif @papers.empty? %>
    <p data-testid="empty-papers">取り込み済みの文書はありません。</p>
  <% end %>

  <% unless @papers.empty? %>
    <table>
      <thead><tr><th>タイトル</th><th>メモ</th><th>取込日</th><th></th></tr></thead>
      <tbody>
        <% @papers.each do |paper| %>
          <tr data-testid="row-paper">
            <td><a href="/papers/<%= paper.id %>"><%= paper.title %></a></td>
            <td><%= paper.note %></td>
            <td><%= paper.created_at&.to_date %></td>
            <td>
              <%= form_with url: "/papers/#{paper.id}/remove", method: :post, local: true do %>
                <button type="submit">取り消す</button>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>

  <%= form_with url: "/animals/#{@patient.karte_no}/papers", method: :post, local: true do %>
    <input type="text" name="title" placeholder="タイトル" required>
    <input type="text" name="note" placeholder="メモ">
    <button type="submit">取り込む</button>
  <% end %>

  <%= form_with url: "/animals/#{@patient.karte_no}/papers/no_paper", method: :post, local: true do %>
    <% if @patient.no_paper? %>
      <%= hidden_field_tag :value, "0" %>
      <button type="submit" data-testid="btn-unset-no-paper">「元から無い」の印を外す</button>
    <% else %>
      <%= hidden_field_tag :value, "1" %>
      <button type="submit" data-testid="btn-set-no-paper">この子の紙カルテは元から無い、の印を付ける</button>
    <% end %>
  <% end %>

  <p><a href="/papers/no-paper">「元から無い」の説明へ</a></p>
  <p><a href="/animals/<%= @patient.karte_no %>">顧客詳細へ戻る</a></p>
</div>
