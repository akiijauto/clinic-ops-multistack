<% content_for :title, "入院" %>
<%# <h1>はナビの表示と同じ文字列にする（spec/screens.md 末尾「画面名はナビの表示と
    同じにする」、2026-09-06追記）。日付は可変なので見出しの下に出す。 %>
<div data-testid="screen-ward-day">
  <h1>入院</h1>
  <p>対象日: <%= @date %></p>

  <% if @hospitalizations.empty? %>
    <p data-testid="empty-hospitalization">入院中の患者はいません。</p>
  <% else %>
    <ul>
      <% @hospitalizations.each do |h| %>
        <li data-testid="row-hospitalization">
          <a href="/animals/<%= h.patient.karte_no %>/ward">
            <%= h.patient.name_kanji %>（<%= h.patient.karte_no %>）／ 処置室:<%= h.room %>
            ／ 入院日:<%= h.admitted_on %>
          </a>
        </li>
      <% end %>
    </ul>
  <% end %>

  <p><a href="/">トップへ戻る</a></p>
</div>
