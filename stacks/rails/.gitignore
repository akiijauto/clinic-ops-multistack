# Rails 標準の除外に、このレーンで足したものを加えたもの。

# 一時ファイル・ログ
/.bundle
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep
/storage/*
!/storage/.keep

# ビルド成果物
/public/assets
/app/assets/builds/*
!/app/assets/builds/.keep
/node_modules

# 依存をこのリポジトリの中に閉じているので、中身は追跡しない
/vendor/bundle

# SQLite の実体（合成データは db/seeds.rb から作り直せる）
/db/*.sqlite3
/db/*.sqlite3-*

# 秘密情報
/config/master.key
/config/credentials/*.key
.env
.env.*

# エディタ・OS
.DS_Store
Thumbs.db
